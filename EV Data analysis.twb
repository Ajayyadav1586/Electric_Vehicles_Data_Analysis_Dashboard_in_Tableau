      <aliases enabled='yes' />
      <column caption='Total Vehicles' datatype='integer' name='[Calculation_3031998541357056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([DOL Vehicle ID])' />
      </column>
      <column caption='AVG Electric Range' datatype='real' name='[Calculation_3031998542323713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Electric Range])' />
      </column>
      <column caption='Total BEV Vechicles' datatype='integer' name='[Calculation_3031998546882565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Electric Vehicle Type] =&quot;Battery Electric Vehicle (BEV)&quot;&#10;THEN [DOL Vehicle ID]&#10;END&#10;)' />
      </column>
      <column caption='% of BEV' datatype='real' name='[Calculation_3031998547816454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3031998546882565] / [Calculation_3031998541357056]' />
      </column>
      <column caption='PHEV Vehicles' datatype='integer' name='[Calculation_3031998551121930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Electric Vehicle Type]=&#10;&quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#10;THEN[DOL Vehicle ID]&#10;END&#10;)' />
      </column>
      <column caption='% of PHEV' datatype='real' name='[Calculation_3031998551457803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3031998551121930] / [Calculation_3031998541357056]' />
      </column>
